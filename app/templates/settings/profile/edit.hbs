{{page-title "Edit Profile — Settings"}}
<RouteLayout @flashMessages={{this.flashMessages}}>
  <:subnav>
    <LinkTo @route="settings.profile" class="nav-link">Profile</LinkTo>
    <LinkTo @route="settings.data" class="nav-link">Data</LinkTo>
    <LinkTo @route="settings.appearance" class="nav-link">Appearance</LinkTo>
    <LinkTo @route="settings.ai-spend" class="nav-link">AI Spend</LinkTo>
  </:subnav>
  <:main>
    <div class="panel-card">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold">Edit Profile</h1>
      </div>

      <fieldset disabled={{this.isSubmitting}}>
        <form class="builder-form two-col" {{on "submit" this.save}}>
          <div class="field">
            <label class="field-label" for="settings-first-name">First name</label>
            <input
              id="settings-first-name"
              type="text"
              value={{this.firstName}}
              {{on "input" (fn this.updateField "firstName")}}
            />
          </div>

          <div class="field">
            <label class="field-label" for="settings-last-name">Last name</label>
            <input
              id="settings-last-name"
              type="text"
              value={{this.lastName}}
              {{on "input" (fn this.updateField "lastName")}}
            />
          </div>

          <div class="field">
            <label class="field-label" for="settings-email">Email</label>
            <input
              id="settings-email"
              type="email"
              value={{this.email}}
              {{on "input" (fn this.updateField "email")}}
            />
          </div>

          <div class="field">
            <label class="field-label" for="settings-phone">Phone</label>
            <input
              id="settings-phone"
              type="tel"
              value={{this.phone}}
              {{on "input" (fn this.updateField "phone")}}
            />
          </div>

          <div class="field-full">
            <label class="field-label" for="settings-address">Address</label>
            <textarea
              id="settings-address"
              rows="2"
              value={{this.address}}
              {{on "input" (fn this.updateField "address")}}
            ></textarea>
          </div>

          <div class="col-span-full">
            <label class="field-label">Quick-copy items</label>
            <p class="text-xs text-gray-400 mt-1 mb-1">One-click copy buttons —
              on the web and in the extension. LinkedIn and GitHub are seeded
              from your profile; add a portfolio link, reusable prompts,
              taglines, etc. Use the up/down arrows to reorder.</p>
          </div>
          <div class="col-span-full min-w-0">
            <AnimatedContainer>
              {{#animated-each
                this.items key="key" duration=220 use=this.reorderTransition
                as |item index|
              }}
                <div
                  class="min-w-0 flex gap-3 items-start pb-3
                    {{unless
                      (eq index 0)
                      'border-t border-gray-200 dark:border-gray-600 pt-4'
                    }}"
                >
                  {{! reorder via house up/down buttons (sortable-move-btn) —
                      hidden for the pinned LinkedIn/GitHub seeds }}
                  {{#unless item.seed}}
                    <div class="flex flex-col pt-2 shrink-0">
                      <button
                        type="button"
                        class="sortable-move-btn"
                        title="Move up"
                        aria-label="Move item up"
                        disabled={{eq index this.firstMovableIndex}}
                        {{on "click" (fn this.moveUp index)}}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="size-4"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m4.5 15.75 7.5-7.5 7.5 7.5"
                          />
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="sortable-move-btn"
                        title="Move down"
                        aria-label="Move item down"
                        disabled={{eq index this.lastIndex}}
                        {{on "click" (fn this.moveDown index)}}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="size-4"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m19.5 8.25-7.5 7.5-7.5-7.5"
                          />
                        </svg>
                      </button>
                    </div>
                  {{/unless}}
                  <div class="w-1/3 min-w-0 flex flex-col gap-2">
                    <input
                      type="text"
                      value={{item.name}}
                      placeholder="Label"
                      aria-label="Item label"
                      disabled={{if item.seed true false}}
                      class="w-full min-w-0 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 disabled:bg-gray-100 dark:disabled:bg-gray-800 disabled:text-gray-500 px-3 py-2 text-sm"
                      {{on "input" (fn this.updateItemField index "name")}}
                    />
                    {{! icon picker — locked for the seeded linkedin/github rows }}
                    {{#unless item.seed}}
                      <div class="flex gap-1" role="group" aria-label="Icon">
                        {{#each this.iconChoices as |choice|}}
                          <button
                            type="button"
                            aria-label={{choice}}
                            aria-pressed={{if
                              (eq item.icon choice)
                              "true"
                              "false"
                            }}
                            class="p-1.5 rounded border
                              {{if
                                (eq item.icon choice)
                                'border-blue-500 bg-blue-100 text-blue-600 dark:bg-blue-900/40 dark:text-blue-300'
                                'border-transparent text-gray-400 dark:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700'
                              }}"
                            {{on "click" (fn this.setItemIcon index choice)}}
                          >
                            <QuickCopyIcon
                              @icon={{choice}}
                              @class="size-4 shrink-0"
                            />
                          </button>
                        {{/each}}
                      </div>
                    {{/unless}}
                    {{#if item.seed}}
                      <span
                        class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500"
                      >
                        <QuickCopyIcon
                          @icon={{item.icon}}
                          @class="size-4 shrink-0"
                        />
                        Pinned
                      </span>
                    {{else}}
                      <button
                        type="button"
                        class="self-start px-2 py-1 text-xs rounded border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30"
                        {{on "click" (fn this.removeItem index)}}
                      >Remove</button>
                    {{/if}}
                  </div>
                  <textarea
                    placeholder="Content to copy"
                    aria-label="Item content"
                    rows="3"
                    class="flex-1 min-w-0 rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm resize-y"
                    {{on "input" (fn this.updateItemField index "value")}}
                  >{{item.value}}</textarea>
                </div>
              {{/animated-each}}
            </AnimatedContainer>
          </div>
          <div class="field-row col-span-full">
            <button
              type="button"
              class="btn small"
              {{on "click" this.addItem}}
            >+ Add item</button>
          </div>

          <div
            class="col-span-full border-t border-gray-200 dark:border-gray-600 pt-4 mt-2"
          >
            <label class="flex items-center gap-3 cursor-pointer">
              <input
                id="settings-wizard-enabled"
                type="checkbox"
                checked={{this.wizardEnabled}}
                {{on "change" this.updateWizardEnabled}}
                class="size-4"
              />
              <span>
                <span class="field-label block">Let Caddy guide me through setup</span>
                <span
                  class="text-xs text-gray-500 dark:text-gray-400 block"
                >When enabled, Caddy will suggest next steps and flag gaps in
                  your setup from the chat sidebar.</span>
              </span>
            </label>
          </div>

          <div class="form-actions justify-end">
            <button type="submit" class="btn primary">
              {{if this.isSubmitting "Saving\u2026" "Save"}}
            </button>
            <button
              type="button"
              class="btn"
              {{on "click" this.cancel}}
            >Cancel</button>
          </div>
        </form>
      </fieldset>
    </div>
  </:main>
</RouteLayout>