{{page-title "Profile — Settings"}}
<RouteLayout @flashMessages={{this.flashMessages}}>
  <:subnav>
    <LinkTo @route="settings.profile" class="nav-link">Profile</LinkTo>
    <LinkTo @route="settings.data" class="nav-link">Data</LinkTo>
    <LinkTo @route="settings.appearance" class="nav-link">Appearance</LinkTo>
    <LinkTo @route="settings.ai-spend" class="nav-link">AI Spend</LinkTo>
  </:subnav>
  <:main>
    <div class="panel-card">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold">Profile</h1>
        <LinkTo @route="settings.profile.edit" class="btn primary">Edit</LinkTo>
      </div>

      <dl class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
        <div>
          <dt class="font-medium text-gray-500 dark:text-gray-400">Name</dt>
          <dd
            class="mt-1 text-gray-900 dark:text-gray-100"
          >{{this.model.name}}</dd>
        </div>
        <div>
          <dt class="font-medium text-gray-500 dark:text-gray-400">Username</dt>
          <dd
            class="mt-1 text-gray-900 dark:text-gray-100"
          >{{this.model.username}}</dd>
        </div>
        <div>
          <dt class="font-medium text-gray-500 dark:text-gray-400">Email</dt>
          <dd class="mt-1 text-gray-900 dark:text-gray-100">{{or
              this.model.email
              "—"
            }}</dd>
        </div>
        <div>
          <dt class="font-medium text-gray-500 dark:text-gray-400">Phone</dt>
          <dd class="mt-1 text-gray-900 dark:text-gray-100">{{or
              this.model.phone
              "—"
            }}</dd>
        </div>
        <div class="col-span-2">
          <dt class="font-medium text-gray-500 dark:text-gray-400">Address</dt>
          <dd
            class="mt-1 text-gray-900 dark:text-gray-100 whitespace-pre-line"
          >{{or this.model.address "—"}}</dd>
        </div>
      </dl>

      {{! CCEXT-18: unified one-click quick-copy list — LinkedIn + GitHub
          (seeded from their dedicated fields) + saved snippets/links, each with
          an icon. Replaces the old per-field/two-click copy affordances. }}
      <div class="mt-8 border-t border-gray-200 dark:border-gray-700 pt-6">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">
            Quick copy
          </h2>
          <LinkTo
            @route="settings.profile.edit"
            class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
          >Manage</LinkTo>
        </div>
        {{#if this.quickCopyItems.length}}
          <ul class="space-y-2 stagger-rows">
            {{#each this.quickCopyItems as |item index|}}
              <li>
                <button
                  type="button"
                  class="w-full flex items-center gap-3 min-w-0 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-2 text-left text-sm hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring focus:ring-blue-200 dark:focus:ring-blue-800"
                  {{on "click" (fn this.copyItem index)}}
                >
                  <QuickCopyIcon
                    @icon={{item.icon}}
                    @class="size-5 shrink-0 text-gray-400 dark:text-gray-500"
                  />
                  <span
                    class="font-medium text-gray-700 dark:text-gray-200 shrink-0"
                  >{{item.name}}</span>
                  <span
                    class="text-gray-400 dark:text-gray-500 truncate min-w-0 flex-1"
                  >{{item.value}}</span>
                  <span class="shrink-0 text-xs font-medium">
                    {{#if (eq this.copiedIndex index)}}
                      <span class="text-green-600 dark:text-green-400">Copied!</span>
                    {{else}}
                      <span class="text-gray-400 dark:text-gray-500">Copy</span>
                    {{/if}}
                  </span>
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="text-sm text-gray-400 dark:text-gray-500">
            No quick-copy items yet.
            <LinkTo
              @route="settings.profile.edit"
              class="text-blue-600 dark:text-blue-400 hover:underline"
            >Add some</LinkTo>
            — LinkedIn, a portfolio link, reusable prompts, taglines.
          </p>
        {{/if}}
      </div>
    </div>
  </:main>
</RouteLayout>