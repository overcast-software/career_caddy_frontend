{{page-title "Resumes"}}
<RouteLayout @flashMessages={{this.flashMessages}}>
  <:subnav>
    <div class="controls">
      <LinkTo @route="resumes.new" class="btn">+ New Resume</LinkTo>
      <LinkTo @route="resumes.import" class="btn">Import Resume</LinkTo>
    </div>
  </:subnav>
  <:main>
    <ResponsiveList @items={{this.model}} @emptyMessage="No resumes yet.">
      <:header as |h|>
        <h.col>Name</h.col>
        <h.col @align="center">Applications</h.col>
        <h.col>Notes</h.col>
        <h.col @align="right">Actions</h.col>
      </:header>
      <:row as |resume r|>
        <Resumes::Compact
          @resume={{resume}}
          @r={{r}}
          @onDelete={{this.deleteResume}}
          @onToggleFavorite={{this.toggleFavorite}}
        />
      </:row>
    </ResponsiveList>
  </:main>
</RouteLayout>