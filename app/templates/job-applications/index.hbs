{{page-title "Applications"}}
<RouteLayout @flashMessages={{this.flashMessages}}>
  <:subnav>
    <div class="controls">
      <Menus::SubnavSearch
        @value={{this.search}}
        @onSearch={{this.updateSearch}}
        @onSearchStart={{this.startSearching}}
        @placeholder="Search applications..."
      />
      <LinkTo @route="job-applications.new" class="btn">+New Application</LinkTo>
    </div>
  </:subnav>
  <:main>
    {{#if this.isSearching}}
      <div
        class="py-8 text-center text-sm text-gray-400 dark:text-gray-500"
      >Searching…</div>
    {{else}}
      <ResponsiveList
        @items={{this.model}}
        @emptyMessage="No applications found."
      >
        <:header as |h|>
          <h.col>Title</h.col>
          <h.col>Company</h.col>
          <h.col>Status</h.col>
          <h.col>Applied At</h.col>
          <h.col @align="right">Actions</h.col>
        </:header>
        <:row as |application r|>
          <JobApplications::Compact
            @jobApplication={{application}}
            @r={{r}}
            @onDelete={{this.removeApplication}}
          />
        </:row>
      </ResponsiveList>
      {{#if this.model.length}}
        <InfinityLoader @infinityModel={{this.model}} @hideOnInfinity={{true}}>
          <div
            class="py-4 text-center text-sm text-gray-400 dark:text-gray-500"
          >Loading more…</div>
        </InfinityLoader>
      {{/if}}
    {{/if}}
  </:main>
</RouteLayout>