<div class="favorites-container">
  <h1>Favorites</h1>

  <div class="favorites-controls">
    <button
      type="button"
      class="btn {{if this.showOnlyFavorites 'primary'}}"
      {{on "click" this.toggleFilterMode}}
    >
      {{if this.showOnlyFavorites "Show All" "Show Favorites Only"}}
    </button>
  </div>

  <div class="tabs">
    <button
      type="button"
      class="tab-button {{if (eq this.activeTab 'resumes') 'active'}}"
      {{on "click" (fn this.setActiveTab "resumes")}}
    >
      Resumes ({{this.filteredResumes.length}})
    </button>
    <button
      type="button"
      class="tab-button {{if (eq this.activeTab 'coverLetters') 'active'}}"
      {{on "click" (fn this.setActiveTab "coverLetters")}}
    >
      Cover Letters ({{this.filteredCoverLetters.length}})
    </button>
    <button
      type="button"
      class="tab-button {{if (eq this.activeTab 'answers') 'active'}}"
      {{on "click" (fn this.setActiveTab "answers")}}
    >
      Answers ({{this.filteredAnswers.length}})
    </button>
  </div>

  {{! CC-267 (phase D2 of CC-260): all three tabs render through
      <ResponsiveList> — the real table at ≥md, labeled stacked cards below
      768px. The favorite toggle moved from its own leading column into the
      @actions group so it keeps a real tap target on a card and so this
      page matches resumes/index (Resumes::Compact already grouped it with
      Edit/Delete). }}
  <div class="tab-content">
    {{#if (eq this.activeTab "resumes")}}
      <div class="mb-6">
        <h2>Resumes</h2>
        <ResponsiveList
          @items={{this.filteredResumes}}
          @emptyMessage="No resumes found."
        >
          <:header as |h|>
            <h.col>Name</h.col>
            <h.col>Notes</h.col>
            <h.col @align="center">Job Applications</h.col>
            <h.col @align="right">Actions</h.col>
          </:header>
          <:row as |resume r|>
            <r.cell @primary={{true}}>
              <LinkTo @route="resumes.show" @model={{resume.id}}>
                {{resume.name}}
              </LinkTo>
            </r.cell>
            <r.cell
              @label="Notes"
              @value={{resume.notes}}
              @dropIfEmpty={{true}}
            >
              {{#if resume.notes}}
                {{resume.notes}}
              {{else}}
                <span class="text-gray-400 dark:text-gray-600">&mdash;</span>
              {{/if}}
            </r.cell>
            <r.cell @label="Job Applications" @align="center">
              {{resume.jobApplications.length}}
            </r.cell>
            <r.cell @actions={{true}}>
              <Buttons::Favorite
                @model={{resume}}
                @onToggle={{fn this.toggleFavorite resume}}
              />
              <LinkTo
                @route="resumes.edit"
                @model={{resume.id}}
                class="rounded border border-gray-200 px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >Edit</LinkTo>
            </r.cell>
          </:row>
        </ResponsiveList>
      </div>
    {{/if}}

    {{#if (eq this.activeTab "coverLetters")}}
      <div class="mb-6">
        <h2>Cover Letters</h2>
        <ResponsiveList
          @items={{this.filteredCoverLetters}}
          @emptyMessage="No cover letters found."
        >
          <:header as |h|>
            <h.col>Name</h.col>
            <h.col>Content Preview</h.col>
            <h.col @align="right">Actions</h.col>
          </:header>
          <:row as |coverLetter r|>
            <r.cell @primary={{true}}>
              <LinkTo @route="cover-letters.show" @model={{coverLetter.id}}>
                {{coverLetter.name}}
              </LinkTo>
            </r.cell>
            <r.cell
              @label="Content Preview"
              @value={{coverLetter.content}}
              @dropIfEmpty={{true}}
            >
              {{#if coverLetter.content}}
                {{truncate coverLetter.content 100}}
              {{else}}
                <span class="text-gray-400 dark:text-gray-600">&mdash;</span>
              {{/if}}
            </r.cell>
            <r.cell @actions={{true}}>
              <Buttons::Favorite
                @model={{coverLetter}}
                @onToggle={{fn this.toggleFavorite coverLetter}}
              />
              <LinkTo
                @route="cover-letters.edit"
                @model={{coverLetter.id}}
                class="rounded border border-gray-200 px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >Edit</LinkTo>
            </r.cell>
          </:row>
        </ResponsiveList>
      </div>
    {{/if}}

    {{#if (eq this.activeTab "answers")}}
      <div class="mb-6">
        <h2>Answers</h2>
        <ResponsiveList
          @items={{this.filteredAnswers}}
          @emptyMessage="No answers found."
        >
          <:header as |h|>
            <h.col>Question</h.col>
            <h.col>Answer Preview</h.col>
            <h.col @align="right">Actions</h.col>
          </:header>
          <:row as |answer r|>
            <r.cell @primary={{true}}>
              {{#if answer.question.id}}
                <LinkTo @route="questions.show" @model={{answer.question.id}}>
                  {{truncate answer.question.text 50}}
                </LinkTo>
              {{else}}
                <span class="text-gray-400 dark:text-gray-600">&mdash;</span>
              {{/if}}
            </r.cell>
            <r.cell
              @label="Answer Preview"
              @value={{answer.text}}
              @dropIfEmpty={{true}}
            >
              {{#if answer.text}}
                {{truncate answer.text 100}}
              {{else}}
                <span class="text-gray-400 dark:text-gray-600">&mdash;</span>
              {{/if}}
            </r.cell>
            <r.cell @actions={{true}}>
              <Buttons::Favorite
                @model={{answer}}
                @onToggle={{fn this.toggleFavorite answer}}
              />
              <LinkTo
                @route="answers.edit"
                @model={{answer.id}}
                class="rounded border border-gray-200 px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
              >Edit</LinkTo>
            </r.cell>
          </:row>
        </ResponsiveList>
      </div>
    {{/if}}
  </div>
</div>