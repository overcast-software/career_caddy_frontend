{{outlet}}

<div class="flex items-center justify-between mb-4">
  <h2
    class="text-lg font-semibold text-gray-800 dark:text-gray-200"
  >Questions</h2>
  <LinkTo @route="job-posts.show.questions.new" class="btn">New Question</LinkTo>
</div>

{{#if this.model.length}}
  {{! The inline answer editor rides the primitive's <:expansion> block:
    one question at a time, keyed by @expandedId, so it lands under the row
    at ≥md and inside the card below md. }}
  <ResponsiveList
    @items={{this.model}}
    @expandedId={{this.answeringQuestionId}}
  >
    <:header as |h|>
      <h.col>Question</h.col>
      <h.col @align="center">Answers</h.col>
      <h.col @align="center">Fav</h.col>
      <h.col @align="right">Actions</h.col>
    </:header>
    <:row as |question r|>
      <r.cell @primary={{true}}>
        <span
          class="block max-w-lg whitespace-pre-wrap break-words"
        >{{question.content}}</span>
      </r.cell>

      {{! @dropIfEmpty keeps the card quiet: an unanswered, un-starred
        question shows title + actions only, while the table keeps both
        columns (and their "—"/"☆") so the grid stays aligned. }}
      <r.cell
        @label="Answers"
        @align="center"
        @dropIfEmpty={{true}}
        @value={{question.answers.length}}
      >
        {{#if question.answers.length}}
          <LinkTo
            @route="job-posts.show.questions.show.answers"
            @model={{question}}
            class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-accent-100 text-accent-700 text-xs font-semibold hover:bg-accent-200 dark:bg-accent-900 dark:text-accent-300 dark:hover:bg-accent-800"
          >{{question.answers.length}}</LinkTo>
        {{else}}
          <span class="text-gray-300 dark:text-gray-600 text-xs">&mdash;</span>
        {{/if}}
      </r.cell>

      <r.cell
        @label="Fav"
        @align="center"
        @dropIfEmpty={{true}}
        @value={{question.favorite}}
      >
        <span class="text-base">{{if question.favorite "★" "☆"}}</span>
      </r.cell>

      <r.cell @actions={{true}}>
        <LinkTo
          @route="job-posts.show.questions.show"
          @model={{question}}
          class="px-2 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
        >Show</LinkTo>
        <button
          type="button"
          class="px-2 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
          {{on "click" (fn this.editQuestion question)}}
        >Edit</button>
        <button
          type="button"
          class="px-2 py-1 text-xs rounded border border-red-200 text-red-600 hover:bg-red-50 dark:border-red-800 dark:text-red-400 dark:hover:bg-red-900/30"
          {{on "click" (fn this.deleteQuestion question)}}
        >Delete</button>
        <button
          type="button"
          class="px-2 py-1 text-xs rounded border
            {{if
              (eq this.answeringQuestionId question.id)
              'border-accent-400 bg-accent-50 text-accent-700 dark:border-accent-500 dark:bg-accent-900/50 dark:text-accent-300'
              'border-accent-200 text-accent-600 hover:bg-accent-50 dark:border-accent-600 dark:text-accent-400 dark:hover:bg-accent-900/30'
            }}"
          {{on "click" (fn this.startAnswering question)}}
        >Answer</button>
      </r.cell>
    </:row>
    <:expansion as |question|>
      <Questions::InlineAnswer
        @question={{question}}
        @onCancel={{this.cancelAnswer}}
        @onComplete={{this.answerComplete}}
        @onSave={{this.answerSaved}}
      />
    </:expansion>
  </ResponsiveList>
{{else}}
  <div class="text-center py-12 text-gray-400 dark:text-gray-500">
    <p class="text-sm">No questions yet.</p>
    <LinkTo
      @route="job-posts.show.questions.new"
      class="mt-2 inline-block text-sm text-accent-500 hover:underline dark:text-accent-400"
    >Add the first one →</LinkTo>
  </div>
{{/if}}