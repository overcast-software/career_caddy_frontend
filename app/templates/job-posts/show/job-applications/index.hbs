{{outlet}}

<section class="panel-card mb-6">
  <h2 class="panel-title">New application</h2>
  <div class="panel-body">
    <div class="flex items-center gap-2">
      <div class="flex-1 max-w-xs">
        <PowerSelect
          @options={{this.resumes}}
          @selected={{this.selectedResume}}
          @onChange={{this.selectResume}}
          @placeholder="Select resume…"
          as |resume|
        >{{or resume.name resume.title}}</PowerSelect>
      </div>
      <LinkTo
        @route="job-posts.show.job-applications.new"
        class="btn shrink-0"
      >Apply</LinkTo>
    </div>
  </div>
</section>

<section class="mb-6">
  <h2 class="panel-title">Applications</h2>
  <ResponsiveList
    @items={{this.model}}
    @emptyMessage="No applications for this job post yet."
  >
    <:header as |h|>
      <h.col>Job Post</h.col>
      <h.col>Company</h.col>
      <h.col>Status</h.col>
      <h.col>Applied</h.col>
      <h.col @align="right">Actions</h.col>
    </:header>
    <:row as |jobApplication r|>
      <JobApplications::Compact @jobApplication={{jobApplication}} @r={{r}} />
    </:row>
  </ResponsiveList>
</section>