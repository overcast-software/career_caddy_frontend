<div class="flex items-center justify-end mb-4">
  <LinkTo @route="companies.show.job-applications.new" class="btn shrink-0">+New
    Application</LinkTo>
</div>

<ResponsiveList
  @items={{this.model}}
  @emptyMessage="No job applications for this company."
>
  <:header as |h|>
    <h.col>Job Post</h.col>
    <h.col>Status</h.col>
    <h.col>Applied</h.col>
    <h.col @align="right">Actions</h.col>
  </:header>
  <:row as |jobApplication r|>
    <JobApplications::Compact
      @jobApplication={{jobApplication}}
      @r={{r}}
      @showCompany={{false}}
    />
  </:row>
</ResponsiveList>