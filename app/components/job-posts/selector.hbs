{{yield}}
<CcSelect
  @options={{this.postByCompany}}
  @selected={{this.selected}}
  @onChange={{this.updateJobPost}}
  @onOpen={{this.loadDefaultOptions}}
  @searchEnabled={{true}}
  @search={{this.searchJobPosts}}
  @allowClear={{@allowClear}}
  @placeholder={{this.placeholder}}
  as |jobPost|
>
  {{jobPost.title}}
</CcSelect>