<ResponsiveList @items={{@companies}} @emptyMessage="No companies found.">
  <:header as |h|>
    <h.col>Name</h.col>
    <h.col>Job Posts</h.col>
    <h.col>Applications</h.col>
    <h.col @align="right">Actions</h.col>
  </:header>
  <:row as |company r|>
    <r.cell @primary={{true}}>
      <LinkTo @route="companies.show.job-posts" @model={{company}}>
        {{company.name}}
      </LinkTo>
    </r.cell>

    <r.cell @label="Job Posts">
      {{company.jobPosts.length}}
    </r.cell>

    <r.cell @label="Applications">
      {{company.jobApplications.length}}
    </r.cell>

    <r.cell @actions={{true}}>
      <LinkTo
        @route="companies.show"
        @model={{company}}
        class="px-2 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"
      >View</LinkTo>
      <LinkTo
        @route="companies.edit"
        @model={{company}}
        class="px-2 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"
      >Edit</LinkTo>
      {{#if @canDelete}}
        <button
          type="button"
          class="px-2 py-1 text-xs rounded border border-red-200 text-red-600 hover:bg-red-50 dark:border-red-800 dark:text-red-400 dark:hover:bg-red-900/30"
          {{on "click" (fn @onDelete company)}}
        >Delete</button>
      {{/if}}
    </r.cell>
  </:row>
</ResponsiveList>