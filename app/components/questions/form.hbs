<article class="panel-card">
  <h3 class="form-title">{{if
      this.isEditing
      "Edit Question"
      "Add Interview Question"
    }}</h3>
  <p class="form-hint">Capture questions from an application so AI can help
    draft answers.</p>
  <form class="questions-form builder-form two-col" {{on "submit" this.save}}>

    <div class="field" data-test-company-field>
      <label class="field-label">Company
        <span class="required">*</span></label>
      {{#if this.hasLockedContext}}
        <input
          type="text"
          value={{this.selectedCompany.name}}
          disabled="true"
          aria-label="Company"
        />
      {{else}}
        <PowerSelectWithCreate
          @search={{this.searchCompanies}}
          @placeholder="Search or create a company…"
          @onCreate={{this.addCompanyToQuestion}}
          @onChange={{this.updateCompany}}
          @selected={{this.selectedCompany}}
          as |company|
        >
          {{! Name AND display name, because near-duplicate company rows
              exist and they collapse under one label: "Toptal, LLC"
              displays as "Toptal", indistinguishable from the "Toptal"
              row next to it. Attaching the WRONG company to a job post
              is worse than attaching none, so show both whenever they
              disagree. (Dedupe of those rows is a separate concern.) }}
          {{company.name}}
          {{#if
            (and company.displayName (not-eq company.displayName company.name))
          }}
            <span class="ml-1 text-xs text-gray-500 dark:text-gray-400">
              displays as “{{company.displayName}}”
            </span>
          {{/if}}
        </PowerSelectWithCreate>
      {{/if}}
    </div>

    {{! FRON-126. Choosing a job application fills in its job post, but
        when neither carries a company the Company field just stays
        blank — indistinguishable from "not picked yet". State the fact,
        and keep the picker above live so it can be repaired here.

        Not offered on the locked arrival paths (job-posts/:id/questions/new
        and friends), where Company renders as a disabled input and there
        is nothing to repair with. }}
    {{#if this.showCompanyDeadEnd}}
      <div
        class="rounded-md bg-amber-50 p-3 ring-1 ring-inset ring-amber-200 dark:bg-amber-500/10 dark:ring-amber-500/30"
        data-test-company-dead-end
      >
        <div class="flex items-start gap-2">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="size-5 shrink-0 text-amber-600 dark:text-amber-300 mt-0.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"
            />
          </svg>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-amber-800 dark:text-amber-200">
              This job post has no company on it.
            </p>
            <p class="mt-1 text-sm text-amber-800 dark:text-amber-200">
              Neither the application you picked nor
              <span class="font-medium">{{this.selectedJobPost.title}}</span>
              carries one — that is why Company is blank. Choose or create a
              company above and it will be saved to the job post itself, not
              just this question.
            </p>
            {{#if this.attachingCompany}}
              <p
                class="mt-1 text-sm text-amber-700 dark:text-amber-300"
                data-test-attaching-company
              >Attaching to the job post…</p>
            {{/if}}
          </div>
        </div>
      </div>
    {{/if}}

    {{#if this.isLoadingRelated}}
      <p class="loading-hint">Loading applications…</p>
    {{/if}}

    {{! Company is optional here, not a gate. Both pickers search the
        api directly, so you can reach a job post or an application
        without first remembering how its company got recorded. }}
    <div class="field" data-test-job-post-field>
      <label class="field-label">Job Post</label>
      {{#if this.hasLockedContext}}
        <input
          type="text"
          value={{this.selectedJobPost.title}}
          disabled="true"
          aria-label="Job Post"
        />
      {{else}}
        <JobPosts::Selector
          @companyId={{this.selectedCompany.id}}
          @selected={{this.selectedJobPost}}
          @jobPostCallback={{this.updateJobPost}}
          @allowClear={{true}}
        />
      {{/if}}
    </div>

    <div class="field" data-test-job-app-field>
      <label class="field-label">Job Application</label>
      {{#if this.jobAppLocked}}
        <input
          type="text"
          value={{if
            this.selectedJobAppOption.label
            this.selectedJobAppOption.label
            "None"
          }}
          disabled="true"
          aria-label="Job Application"
        />
      {{else}}
        <PowerSelect
          @options={{this.filteredJobAppOptions}}
          @onChange={{this.updateJobApplication}}
          @selected={{this.selectedJobAppOption}}
          @searchEnabled={{true}}
          @search={{this.searchJobApplications}}
          @placeholder="Search applications by job title or company…"
          @allowClear={{true}}
          as |opt|
        >
          {{opt.label}}
        </PowerSelect>
      {{/if}}
    </div>

    <div class="field-full">
      <label class="field-label" for="question-content">Question
        <span class="required">*</span></label>
      <textarea
        id="question-content"
        value={{@question.content}}
        {{on "input" this.updateContent}}
        placeholder="Paste the interview question here…"
        rows="4"
      ></textarea>
    </div>

    {{! Star toggles the favorite state of the question's lone answer.
        Only meaningful when the question has exactly one answer;
        clicking with 0 or >1 answers surfaces a flash error explaining
        why — favoriting is a per-answer concept, not per-question.

        Lives inside the same form-actions row as Save/Cancel/Delete so
        it reads as part of the primary action strip, not a floating
        orphan control above. Star sits at left, Delete at right. }}
    <div class="form-actions justify-between items-center">
      <div class="flex items-center gap-2">
        {{#if @question.id}}
          <button
            type="button"
            class="btn favorite {{if this.loneAnswerFavorited 'favorited'}}"
            title="Favorite the lone answer"
            aria-label="Favorite the lone answer"
            {{on "click" this.toggleLoneAnswerFavorite}}
          >{{if this.loneAnswerFavorited "★" "☆"}}</button>
        {{/if}}
      </div>
      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="btn primary"
          disabled={{@question.isSaving}}
        >
          Save
        </button>
        <button type="button" class="btn" {{on "click" this.cancel}}>
          Cancel
        </button>
        {{#if @question.id}}
          <button
            type="button"
            class="btn danger"
            {{on "click" this.delete}}
          >Delete</button>
        {{/if}}
      </div>
    </div>
  </form>
</article>