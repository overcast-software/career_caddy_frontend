{{! Row content for the resumes index (CC-267, phase D2 of CC-260).
    Renders <ResponsiveList> cells — the <:row> cell hash is handed in as
    @r — so the SAME row logic draws as a table row at ≥md and as a
    stacked card below the md/768 breakpoint.

    @resume            the row's Resume (slim: jobApplicationCount, no hasMany)
    @r                 the ResponsiveList <:row> cell hash (from the route)
    @onToggleFavorite  called with the resume to flip its favorite flag
    @onDelete          called with the resume to destroy it }}
{{#let @r as |r|}}
  <r.cell @primary={{true}}>
    <LinkTo @route="resumes.show" @model={{@resume.id}}>
      {{@resume.name}}
    </LinkTo>
  </r.cell>

  <r.cell @label="Applications" @align="center">
    {{if @resume.jobApplicationCount @resume.jobApplicationCount 0}}
  </r.cell>

  <r.cell @label="Notes" @value={{@resume.notes}} @dropIfEmpty={{true}}>
    {{#if @resume.notes}}
      {{@resume.notes}}
    {{else}}
      <span class="text-gray-400 dark:text-gray-600">&mdash;</span>
    {{/if}}
  </r.cell>

  <r.cell @actions={{true}}>
    <Buttons::Favorite
      @model={{@resume}}
      @onToggle={{fn @onToggleFavorite @resume}}
    />
    <LinkTo
      @route="resumes.edit"
      @model={{@resume.id}}
      class="rounded border border-gray-200 px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700"
    >Edit</LinkTo>
    <button
      type="button"
      class="rounded border border-red-200 px-2 py-1 text-xs text-red-600 hover:bg-red-50 dark:border-red-800 dark:text-red-400 dark:hover:bg-red-900/30"
      {{on "click" (fn @onDelete @resume)}}
    >Delete</button>
  </r.cell>
{{/let}}