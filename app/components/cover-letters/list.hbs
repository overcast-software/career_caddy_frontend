<ResponsiveList
  @items={{@coverLetters}}
  @emptyMessage={{or @emptyMessage "No cover letters found."}}
>
  <:header as |h|>
    <h.col @when={{not (eq @showJobPost false)}}>Job Post</h.col>
    <h.col>Created</h.col>
    <h.col>Favorite</h.col>
    <h.col @align="right">Actions</h.col>
  </:header>
  <:row as |coverLetter r|>
    <r.cell @primary={{true}} @when={{not (eq @showJobPost false)}}>
      {{#if coverLetter.jobPost.id}}
        <LinkTo
          @route="job-posts.show.cover-letters.show"
          @models={{array coverLetter.jobPost coverLetter}}
        >{{coverLetter.jobPost.title}}</LinkTo>
      {{else}}
        <span class="text-gray-400 dark:text-gray-500">&mdash;</span>
      {{/if}}
    </r.cell>

    <r.cell @label="Created">
      {{#if coverLetter.createdAt}}
        {{moment-format coverLetter.createdAt "MMM D, YYYY"}}
      {{else}}
        <span class="text-gray-400 dark:text-gray-500">&mdash;</span>
      {{/if}}
    </r.cell>

    <r.cell
      @label="Favorite"
      @dropIfEmpty={{true}}
      @value={{coverLetter.favorite}}
    >
      {{#if coverLetter.favorite}}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-4 text-amber-400"
        >
          <path
            fill-rule="evenodd"
            d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z"
            clip-rule="evenodd"
          />
        </svg>
      {{/if}}
    </r.cell>

    <r.cell @actions={{true}}>
      {{#if coverLetter.isPending}}
        <SpinnerInline
          @label="Generating…"
          @title="Generating — this page auto-refreshes when ready"
        />
      {{else}}
        {{#if coverLetter.jobPost.id}}
          <LinkTo
            @route="job-posts.show.cover-letters.show"
            @models={{array coverLetter.jobPost coverLetter}}
            class="px-2 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"
          >View</LinkTo>
        {{else}}
          <LinkTo
            @route="cover-letters.show"
            @model={{coverLetter}}
            class="px-2 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"
          >View</LinkTo>
        {{/if}}
      {{/if}}
    </r.cell>
  </:row>
</ResponsiveList>